"use strict";
var spider = document.querySelector(".spider");
var wall = document.querySelector(".wall");
document.addEventListener("click", function(e) {
    var wallRect = wall.getBoundingClientRect();
    if (e.clientX < wallRect.left || e.clientX > wallRect.right || e.clientY < wallRect.top || e.clientY > wallRect.bottom) return;
    var spiderWidth = spider.offsetWidth;
    var spiderHeight = spider.offsetHeight;
    var clickX = e.clientX - wallRect.left - wall.clientLeft;
    var clickY = e.clientY - wallRect.top - wall.clientTop;
    var maxLeft = wall.clientWidth - spiderWidth;
    var maxTop = wall.clientHeight - spiderHeight;
    var left = Math.max(0, Math.min(clickX - spiderWidth / 2, maxLeft));
