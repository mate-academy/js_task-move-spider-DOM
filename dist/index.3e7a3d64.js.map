"use strict";
document.addEventListener("click", function(e) {
    var wall = document.querySelector(".wall");
    if (e.target === wall) {
        var spider = document.querySelector(".spider");
        var startWidth = (window.innerWidth - wall.clientWidth + spider.clientWidth) / 2;
        var startHeight = (window.innerHeight - wall.clientHeight + spider.clientHeight) / 2;
        spider.style.left = e.x - startWidth + "px";
        spider.style.top = e.y - startHeight + "px";
    }
});

